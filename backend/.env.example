PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
SHORT_DOMAIN=url.app

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379
KAFKA_CLIENT_ID=url-shortner-api
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_LINK_EVENTS=url-shortner.link-events

# On Vercel/serverless, set REDIS_URL to a persistent Redis database.
# Without Redis, users and links use temporary in-memory storage and can disappear after cold starts.
